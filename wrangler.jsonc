{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passpilot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "passpilot.ca", "custom_domain": true },
    { "pattern": "www.passpilot.ca", "custom_domain": true }
  ],
  "workers_dev": true,
  // Stripe Price IDs (non-secret). Fill in from `node scripts/stripe-setup.js`.
  // Stripe secret/webhook keys are set via `wrangler secret put`, not here.
  "vars": {
    "STRIPE_PRICE_PRO_MONTHLY": "price_1TefM2PvOTDjFLJjctd6IkZo",
    "STRIPE_PRICE_PRO_YEARLY": "price_1TefM3PvOTDjFLJjtnCn3THK",
    "RESEND_FROM": "PassPilot <noreply@passpilot.ca>"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers Logs: retains invocation logs (incl. CPU time + exceptions) so a
  // runtime 1102 ("exceeded resource limits") can be inspected after the fact
  // instead of only seeing Cloudflare's generic error page. Works on Free plan.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passpilot",
      "database_id": "d996d5de-0bb7-4c75-9951-cd8a490302c8"
    }
  ]
}
